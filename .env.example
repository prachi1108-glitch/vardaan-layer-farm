# Vardaan Layer Farm — environment variable template
# Copy this file to .env and fill in the real values. Never commit .env.

# Neon (Postgres) pooled connection string.
DATABASE_URI="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Long random string used by Payload to sign tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=""

# Public base URL of the site.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Enquiry notifications. When both are set, new enquiries are emailed to
# ENQUIRY_NOTIFY_EMAIL via Resend; otherwise leads are logged server-side.
# RESEND_API_KEY=""
# ENQUIRY_NOTIFY_EMAIL=""
# ENQUIRY_FROM_EMAIL=""   # a Resend-verified sender (defaults to onboarding@resend.dev)
