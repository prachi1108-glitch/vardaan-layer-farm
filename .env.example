# Vardaan Layer Farm — environment variable template
# Copy this file to .env and fill in the real values. Never commit .env.

# Neon (Postgres) connection string. On this dev machine use the DIRECT
# endpoint (see src/lib/db-stream.ts); on Vercel the pooled one is fine.
DATABASE_URI="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# Long random string used by Payload to sign tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=""

# Public base URL of the site (canonical URLs, sitemap, JSON-LD, llms.txt).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Enquiry emails via Resend (PRD FR-2.4, FR-9). Without these, leads are still
# saved and logged; the enquiry's emailStatus shows "Not configured".
# RESEND_API_KEY=""
# ENQUIRY_NOTIFY_EMAIL="vardaanlayerfarm@gmail.com"
# ENQUIRY_FROM_EMAIL="Vardaan Layer Farm <enquiries@vardaanlayerfarm.com>"   # Resend-verified domain

# Cloudflare Turnstile (optional spam protection on the quote form).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET=""

# Google Analytics 4 (optional). Events: generate_lead, contact_click, quote_open.
# NEXT_PUBLIC_GA_ID="G-XXXXXXX"
